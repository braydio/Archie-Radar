ARCHIE_DATABASE_URL=sqlite:///./archie_radar.db
ARCHIE_CORS_ORIGINS=*
ARCHIE_MEDIA_DIR=./media

# Overlapping PawBoost search centers broaden the net while source IDs deduplicate reposted results.
ARCHIE_PAWBOOST_AREAS=chapel-hill-nc-27516,durham-nc-27701,mebane-nc-27302,pittsboro-nc-27312,raleigh-nc-27601,sanford-nc-27330
ARCHIE_PAWBOOST_PAGES=2
ARCHIE_SCAN_MINUTES=30
ARCHIE_AUTO_SCAN=true
ARCHIE_ORANGE_COUNTY_ENABLED=true
ARCHIE_REGIONAL_24PETCONNECT_ENABLED=true
# Saved public 24PetConnect regional search. If 24PetConnect expires it, create a new
# Cat / Lost My Pet search centered on 27516 with a broad radius and replace this URL.
ARCHIE_REGIONAL_24PETCONNECT_URL=https://24petconnect.com/ViewAnimals/2779667
ARCHIE_APS_DURHAM_ENABLED=true
ARCHIE_WAKE_COUNTY_ENABLED=true
ARCHIE_PET911_ENABLED=true
ARCHIE_PET911_PLACES=chapel-hill,durham,raleigh
ARCHIE_PETKEY_ENABLED=true
ARCHIE_PETKEY_PLACES=chapel-hill_nc,durham_nc,raleigh_nc

# Selected-group Facebook aggregation runs in headless Chromium on the Archie Radar server.
# Use the helper extension once to hand the logged-in Facebook session to this local server.
ARCHIE_FACEBOOK_SERVER_COLLECTOR_ENABLED=true
ARCHIE_FACEBOOK_SYNC_MINUTES=60
ARCHIE_FACEBOOK_SESSION_STATE_PATH=./media/facebook/storage-state.json
ARCHIE_FACEBOOK_PAGE_TIMEOUT_SECONDS=35
ARCHIE_FACEBOOK_SCAN_MAX_PASSES=12

ARCHIE_ANALYZE_IMAGES=true
ARCHIE_MAX_IMAGE_BYTES=8000000
SURVEYOR_MAX_VIDEO_MB=500

# Archie search anchor
ARCHIE_HOME_ADDRESS="30 Dollar Road #A, Chapel Hill, NC 27516"
ARCHIE_HOME_LATITUDE=35.845701
ARCHIE_HOME_LONGITUDE=-79.117282
ARCHIE_SEARCH_RADIUS_MILES=25

# Cached, rate-limited OpenStreetMap Nominatim geocoding
ARCHIE_GEOCODE_ENABLED=true
ARCHIE_GEOCODE_USER_AGENT=ArchieRadar/0.7 lost-pet-reunion-project
ARCHIE_GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
ARCHIE_GEOCODE_MIN_DELAY_SECONDS=15.1
ARCHIE_GEOCODE_BACKFILL_LIMIT=150

ARCHIE_PETCO_API_KEY=
ARCHIE_PETCO_API_BASE=https://api.petcolove.org/v2.1
